  "PHP Method with Transaction": {
    "prefix": "phptransaction",
    "body": [
      "public function ${1:methodName}(${2:parameters})",
      "{",
      "   global \\$conexion;",
      "   \\$sw = true;",
      "   \\$conexion->autocommit(false);",
      "   \\$dt = date('Y-m-d H:i:s');",
      "   ",
      "   try {",
      "      ${3:// Lógica del método}",
      "      \\$sql = \"${4:SQL_QUERY}\";",
      "      \\$conexion->query(\\$sql) or throw new Exception('error!');",
      "      ",
      "   } catch (Exception \\$e) {",
      "      \\$sw = false;",
      "      \\$conexion->rollback();",
      "   }",
      "   ",
      "   \\$conexion->commit();",
      "   if (\\$conexion != null) {",
      "      \\$conexion->close();",
      "   }",
      "   ",
      "   \\$msg = \\$sw ? \"${5:Operación exitosa}\" : \"ERROR: ${6:Operación fallida}\";",
      "   echo \\$msg;",
      "   return \\$sw;",
      "}"
    ],
    "description": "Método PHP with full transaction handling"
  },

  "PHP Query Method": {
    "prefix": "phpquery",
    "body": [
      "public function ${1:methodName}(${2:parameters})",
      "{",
      "   global \\$conexion;",
      "   \\$sql = \"${3:SELECT_QUERY}\";",
      "   \\$query = \\$conexion->query(\\$sql);",
      "   return \\$query;",
      "}"
    ],
    "description": "Simple query method template"
  },

  "PHP Duplicate Check": {
    "prefix": "phpduplicatecheck",
    "body": [
      "\\$sql = \"SELECT ${1:id_field} FROM ${2:table_name} WHERE ${3:field}='\\${3:field}' AND idglobal=\\$idglobal\";",
      "\\$query = \\$conexion->query(\\$sql);",
      "\\$result = \\$query->fetch_object();",
      "",
      "if (isset(\\$result->${1:id_field})) {",
      "   echo \"ERROR: Ya existe un registro con estos datos\";",
      "   return;",
      "}"
    ],
    "description": "Check for duplicate records before insert"
  },

  "PHP Auth Check": {
    "prefix": "phpauthcheck",
    "body": [
      "\\$sql = \"SELECT a.str_nombre",
      "         FROM tbl_auth_sucursal au ",
      "         INNER JOIN tbl_auths b ON b.idauth_sucursal=au.idauth_sucursal ",
      "         INNER JOIN tbl_auth a ON a.idauth=b.idauth ",
      "         WHERE au.str_estado<>'inactivo' AND ",
      "               au.idempleado=\\$${1:empleado_id} AND ",
      "               au.idsucursal=\\$${2:idsucursal} AND ",
      "               a.str_nombre='${3:permission_name}'\";",
      "\\$queryAuth = \\$conexion->query(\\$sql);",
      "\\$authResult = \\$queryAuth->fetch_object();",
      "",
      "if (!isset(\\$authResult->str_nombre)) {",
      "   echo \"ERROR: No tiene permisos para esta operación\";",
      "   return;",
      "}"
    ],
    "description": "Check user permissions for operation"
  },

