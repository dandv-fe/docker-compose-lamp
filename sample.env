# Please Note:
# In PHP Versions <= 7.4 MySQL8 is not supported due to lacking pdo support

# To determine the name of your containers
COMPOSE_PROJECT_NAME="webgoez"

# Possible values: php54, php56, php70, php71, php72, php73, php74, php80, php81, php82, php83
PHPVERSION="php81"
DOCUMENT_ROOT="./www"
APACHE_DOCUMENT_ROOT="/var/www/html"
VHOSTS_DIR="./config/vhosts"
APACHE_LOG_DIR="./logs/apache2"
PHP_INI="./config/php/php.ini"

# PHPMyAdmin
UPLOAD_LIMIT="512M"
MEMORY_LIMIT="512M"

# Xdebug
XDEBUG_LOG_DIR=./logs/xdebug
XDEBUG_PORT=9003

# Possible values: mysql57, mysql8, mariadblts, mariadblatest, mariadb10...
DATABASE="mariadb10"
MYSQL_INITDB_DIR="./config/initdb"
MYSQL_DATA_DIR="./data/mysql"
MYSQL_LOG_DIR="./logs/mysql"

# Mapeo de puertos en tu PC
HOST_MACHINE_UNSECURE_HOST_PORT=80
HOST_MACHINE_SECURE_HOST_PORT=443
HOST_MACHINE_MYSQL_PORT=3306
HOST_MACHINE_PMA_PORT=8080
HOST_MACHINE_PMA_SECURE_PORT=8443
HOST_MACHINE_REDIS_PORT=6379

# Credenciales de la Base de Datos
MYSQL_ROOT_PASSWORD="mysql123"
MYSQL_USER="websdnco_user_webgoez"
MYSQL_PASSWORD="root"
MYSQL_DATABASE="websdnco_db_webgoez"

# ID de usuario de Pop!_OS para evitar problemas de permisos de escritura (¡NUEVO!)
CURRENT_UID=1000
